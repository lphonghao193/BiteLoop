# When testing in an emulator on the same computer, host.docker.internal may be
# suitable. For a physical phone, replace it with the computer's LAN IP, such as
# http://192.168.1.20:54321, so the phone can reach local Supabase.
EXPO_PACKAGER_HOSTNAME=192.168.1.20
EXPO_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOONG_MAPTILES_KEY=
